{
  "name": "neocom-back",
  "version": "0.1.0",
  "description": "NestJS server for the NEOCOM ecosystem",
  "author": "",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "@App/*": "./dist/application/*",
    "@Domain/*": "./dist/domain/*",
    "@Infra/*": "./dist/infrastructure/*"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "npm run banner && nest start --watch",
    "start:debug": "npm run banner && nest start --debug --watch",
    "start:prod": "node dist/main",
    "banner": "node scripts/generate-banner.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@lgriffin/esi.ts": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "bullmq": "^6.3.16",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "neocom-domain": "file:../neocom-domain",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "figlet": "^1.12.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
