                  "  pm.expect(body.errors).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.errors[0].code).to.eql('NOT_FOUND');",
                  "  pm.expect(body.errors[0].field).to.eql('pilotId');",
                  "  pm.expect(body.errors[0].container).to.eql('path');",
                  "  pm.expect(body.errors[0].value).to.eql(String(pm.variables.get('unknownPilotId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "500 \u2014 ESI_INDUSTRY_UNAVAILABLE",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/pilots/{{pilotId}}/blueprints",
            "description": "ExceptionCatalog.ESI_INDUSTRY_UNAVAILABLE when ESI industry is network/server-error. Exercise by breaking ESI connectivity; skip in happy-path batch runs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 500 when ESI industry unavailable', () => pm.response.to.have.status(500));",
                  "const body = pm.response.json();",
