  "item": [
    {
      "name": "Auth",
      "description": "OpenAPI: `tools/openapi/auth-service-v0.1.0.yaml` \u2014 `V1AuthController`.",
      "item": [
        {
          "name": "Happy path",
          "description": "Nominal auth flows.",
          "item": [
            {
              "name": "Load session from back",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/v1/auth/session?characterId={{characterId}}",
                "description": "After front SSO. Fills env cookie + pilotId. Spec: GET /v1/auth/session.",
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('session payload', () => {",
                      "  pm.expect(body.characterId).to.be.a('number');",
                      "  pm.expect(body.characterName).to.be.a('string').that.is.not.empty;",
                      "  pm.expect(body.neocomAccessCookie).to.be.a('string').that.is.not.empty;",
                      "  pm.expect(body.cookieName).to.eql('neocom_access');",
                      "});",
                      "function write(key, value) {",
                      "  pm.collectionVariables.set(key, value);",
                      "  try { pm.environment.set(key, value); } catch (e) {}",
                      "}",
                      "write('neocomAccessCookie', body.neocomAccessCookie);",
                      "write('characterId', String(body.characterId));",
                      "write('characterName', body.characterName);",
                      "write('pilotId', String(body.pilotId || body.characterId));",
                      "write('authorization', body.authorization || 'present');"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Load session (first stored character)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/v1/auth/session",
                "description": "Same without characterId.",
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('session payload', () => {",
                      "  pm.expect(body.characterId).to.be.a('number');",
                      "  pm.expect(body.characterName).to.be.a('string').that.is.not.empty;",
                      "  pm.expect(body.neocomAccessCookie).to.be.a('string').that.is.not.empty;",
                      "  pm.expect(body.cookieName).to.eql('neocom_access');",
                      "});",
                      "function write(key, value) {",
                      "  pm.collectionVariables.set(key, value);",
                      "  try { pm.environment.set(key, value); } catch (e) {}",
                      "}",
                      "write('neocomAccessCookie', body.neocomAccessCookie);",
                      "write('characterId', String(body.characterId));",
                      "write('characterName', body.characterName);",
                      "write('pilotId', String(body.pilotId || body.characterId));",
                      "write('authorization', body.authorization || 'present');"
                    ]
                  }
                }
              ]
            },
            {
              "name": "POST callback (SSO exchange)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Cookie",
                    "value": "neocom_sso_state={{ssoStateCookie}}"
                  }
                ],
                "url": "{{baseUrl}}/v1/auth/callback",
                "description": "Requires real EVE SSO code in authCode. Sets neocom_access.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"{{authCode}}\",\n  \"state\": \"{{authState}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('returns characterId and characterName', () => {",
                      "  pm.expect(body).to.have.property('characterId');",
                      "  pm.expect(body).to.have.property('characterName');",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Exceptions",
          "description": "ExceptionCatalog outcomes for Auth.",
          "item": [
            {
              "name": "400 \u2014 SSO_STATE_MISMATCH (state / cookie)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Cookie",
                    "value": "neocom_sso_state={{ssoStateCookie}}"
                  }
                ],
                "url": "{{baseUrl}}/v1/auth/callback",
                "description": "ExceptionCatalog.SSO_STATE_MISMATCH",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"any-code\",\n  \"state\": \"{{mismatchedAuthState}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 400', () => pm.response.to.have.status(400));",
                      "pm.test('NeocomError shape', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.errors).to.be.an('array').that.is.not.empty;",
                      "  pm.expect(body.errors[0]).to.have.property('code');",
                      "  pm.expect(body.errors[0]).to.have.property('description');",
                      "});",
                      "pm.test('code SSO_STATE_MISMATCH', () => pm.expect(pm.response.json().errors[0].code).to.eql('SSO_STATE_MISMATCH'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "400 \u2014 SSO_STATE_MISMATCH (missing code)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Cookie",
                    "value": "neocom_sso_state={{ssoStateCookie}}"
                  }
                ],
                "url": "{{baseUrl}}/v1/auth/callback",
                "description": "",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"state\": \"{{authState}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 400', () => pm.response.to.have.status(400));",
                      "pm.test('code SSO_STATE_MISMATCH', () => pm.expect(pm.response.json().errors[0].code).to.eql('SSO_STATE_MISMATCH'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "400 \u2014 INVALID_REQUEST (characterId not integer)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/v1/auth/session?characterId={{invalidPilotId}}",
                "description": ""
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 400', () => pm.response.to.have.status(400));",
                      "pm.test('code INVALID_REQUEST', () => pm.expect(pm.response.json().errors[0].code).to.eql('INVALID_REQUEST'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "401 \u2014 TOKEN_UNAVAILABLE (unknown characterId in store)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/v1/auth/session?characterId={{unknownPilotId}}",
                "description": "When store has no usable token for that id \u2014 TOKEN_UNAVAILABLE or NOT_FOUND depending on store state."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 401 or 404', () => pm.expect([401,404]).to.include(pm.response.code));",
                      "pm.test('NeocomError shape', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.errors).to.be.an('array').that.is.not.empty;",
                      "  pm.expect(body.errors[0]).to.have.property('code');",
                      "  pm.expect(body.errors[0]).to.have.property('description');",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
