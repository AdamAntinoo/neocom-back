    },
    {
      "name": "Auth \u2014 POST /v1/auth/callback",
      "description": "Contract tests for `POST /v1/auth/callback` (front SSO exchange). Day-to-day Postman auth uses **Session \u2192 00 Load session from back** after a front login.",
      "item": [
        {
          "name": "200 \u2014 exchange code (SSO success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "neocom_sso_state={{ssoStateCookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{authCode}}\",\n  \"state\": \"{{authState}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/auth/callback",
            "description": "Requires a real EVE SSO authorization code in authCode, with authState matching the neocom_sso_state cookie. Sets neocom_access on success."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns characterId and characterName', () => {",
                  "  pm.expect(body).to.have.property('characterId');",
                  "  pm.expect(body).to.have.property('characterName');",
                  "});",
                  "const jar = pm.cookies.toObject();",
                  "let access = jar.neocom_access;",
                  "if (!access) {",
                  "  const raw = pm.response.headers.all()",
                  "    .filter((h) => h.key.toLowerCase() === 'set-cookie')",
                  "    .map((h) => h.value)",
                  "    .find((v) => v.startsWith('neocom_access='));",
                  "  if (raw) access = decodeURIComponent(raw.split(';')[0].slice('neocom_access='.length));",
                  "}",
                  "pm.test('neocom_access cookie captured', () => pm.expect(access).to.be.ok);",
                  "if (access) {",
                  "  pm.environment.set('neocomAccessCookie', access);",
                  "  pm.collectionVariables.set('neocomAccessCookie', access);",
                  "}",
                  "pm.environment.set('characterId', String(body.characterId));",
                  "pm.environment.set('characterName', body.characterName);",
                  "pm.environment.set('pilotId', String(body.characterId));",
                  "pm.collectionVariables.set('characterId', String(body.characterId));",
                  "pm.collectionVariables.set('characterName', body.characterName);",
                  "pm.collectionVariables.set('pilotId', String(body.characterId));",
                  "console.log('Logged in as', body.characterName, body.characterId);"
                ]
              }
            }
          ]
        },
        {
          "name": "400 \u2014 SSO_STATE_MISMATCH (state / cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "neocom_sso_state={{ssoStateCookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"any-code\",\n  \"state\": \"{{mismatchedAuthState}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/auth/callback",
            "description": "ExceptionCatalog.SSO_STATE_MISMATCH when body.state does not equal the neocom_sso_state cookie (or code/state missing)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('NeocomError SSO_STATE_MISMATCH', () => {",
                  "  pm.expect(body.errors).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.errors[0].code).to.eql('SSO_STATE_MISMATCH');",
                  "  pm.expect(body.errors[0].description).to.eql('The request state does not match. Caller not verified.');",
                  "  pm.expect(body.errors[0].field).to.eql('state');",
                  "  pm.expect(body.errors[0].container).to.eql('body');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "400 \u2014 SSO_STATE_MISMATCH (missing code)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "neocom_sso_state={{ssoStateCookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"{{authState}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/auth/callback",
            "description": "Empty/missing code also fails the state verification gate \u2192 SSO_STATE_MISMATCH."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('NeocomError SSO_STATE_MISMATCH', () => {",
                  "  pm.expect(body.errors).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.errors[0].code).to.eql('SSO_STATE_MISMATCH');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
