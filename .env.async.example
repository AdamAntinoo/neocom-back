# Copy to .env.async for local async enrichment (see neocom-meta/infra/async-persistence.md).
# Leave unset to use in-memory store + in-process enrichment (unit tests / offline).

DATABASE_URL=postgresql://neocom:neocom@localhost:5432/neocom_async
REDIS_URL=redis://localhost:6379
ASYNC_SSE_CHANNEL_PREFIX=neocom:sse:
# Dev only — auto-create tables when using TypeORM without running SQL migrations:
TYPEORM_SYNC=true
