#!/usr/bin/env bash
# Sync package version from GitVersion, then align local Postgres via Flyway when Docker is up.
set -euo pipefail

if [[ "${SKIP_VERSION_SYNC:-}" == "1" ]]; then
  :
else
  if ! command -v gitversion >/dev/null 2>&1; then
    echo "pre-commit: gitversion not on PATH — skipping version:sync (CI hook will sync)." >&2
  else
    root="$(git rev-parse --show-toplevel)"
    cd "$root"
    npm run version:sync
    for path in package.json .env.version .app-banner.txt; do
      if [[ -f "$path" ]]; then
        git add -- "$path"
      fi
    done
  fi
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec bash "${ROOT}/tools/db/git-sync.sh" --strict
