# Local async enrichment (loaded by AppModule ConfigModule).
# Start Postgres + Redis: npm run docker:up  (tools/docker/docker-compose.yml)
# Apply schema with Flyway:     npm run db:migrate  (tools/db/)
# Programme notes: neocom-meta/infra/async-persistence.md
# Comment out or remove DATABASE_URL / REDIS_URL to use in-memory store + in-process enrichment.

# Dev-watch ports: back 6002 → Postgres 6003 → Redis 6004 (programme 600x range).
DATABASE_URL=postgresql://neocom:neocom@localhost:6003/neocom_async
REDIS_URL=redis://localhost:6004
ASYNC_SSE_CHANNEL_PREFIX=neocom:sse:
# Keep false when Flyway owns schema (npm run db:migrate). true = TypeORM auto-sync spike only.
TYPEORM_SYNC=false
